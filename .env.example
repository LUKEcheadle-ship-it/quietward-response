QWR_ENVIRONMENT=development
# Relative SQLite paths are resolved from backend/, which is where the launch scripts run.
QWR_DATABASE_URL=sqlite:///./quietward-response.db
QWR_API_HOST=127.0.0.1
QWR_API_PORT=8002
QWR_CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
QWR_CORRELATION_WINDOW_SECONDS=300
QWR_LOG_LEVEL=INFO
QWR_SEED_DEMO=false

# Loopback-only development fallback. bootstrap_local.sh replaces this before local enrollment.
QWR_ENROLLMENT_TOKEN=development-enrollment-token-change-me
QWR_AGENT_REPLAY_WINDOW_SECONDS=300
QWR_ACTION_DEFAULT_TTL_SECONDS=600
QWR_REQUIRE_AGENT_AUTH_FOR_QUIETWARD_EVENTS=true

# Optional explicit browser API URL. Leave commented to derive it from QWR_API_PORT.
# NEXT_PUBLIC_API_URL=http://localhost:8002

# Docker Compose PostgreSQL development credentials only. Override outside local development.
POSTGRES_DB=quietward_response
POSTGRES_USER=quietward_response
POSTGRES_PASSWORD=change-this-local-password
