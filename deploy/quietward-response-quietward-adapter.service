[Unit]
Description=QuietWard to QuietWard Response event adapter
After=network-online.target quietward.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/quietward-response-agent/forward_quietward_events.py --config %h/.config/quietward-response/adapter.json --quietward-db %h/.local/state/quietward/quietward.sqlite3
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/quietward-response-agent
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
